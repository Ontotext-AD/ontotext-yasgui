diff --git a/Yasgui/packages/yasqe/grammar/sparql11-grammar.pl b/Yasgui/packages/yasqe/grammar/sparql11-grammar.pl
--- a/Yasgui/packages/yasqe/grammar/sparql11-grammar.pl	(revision 0157f3597c0659a9dd96ec1b7661f7534db55862)
+++ b/Yasgui/packages/yasqe/grammar/sparql11-grammar.pl	(revision b7d845f6f09255cab069ea75023a3184b032bb79)
@@ -76,8 +76,11 @@
          or
 	 [*(datasetClause),'WHERE','{',?(triplesTemplate),'}',solutionModifier]].
 
+% Not in spec: SPARQL 1.2 allows only VarOrIri as a DESCRIBE target. GraphDB
+% also describes triple terms, e.g. DESCRIBE <<( :s :p :o )>>, so we accept
+% them in the expression form (iri, Var or literal terms, no blank nodes).
 describeQuery ==>
-	['DESCRIBE',+(varOrIRIref) or '*',
+	['DESCRIBE',+(varOrIRIref or exprTripleTerm) or '*',
 	*(describeDatasetClause),?(whereClause),solutionModifier].
 
 askQuery ==>
