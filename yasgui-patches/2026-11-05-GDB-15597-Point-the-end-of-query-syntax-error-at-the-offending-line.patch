                   // (e.g. SELECT (COUNT(?v) AS ?c) (?c + 1 AS ?cPlusOne)).
-                  state.selectBareVars.add(tokenOb.string);
+                  if (!state.selectBareVars.has(tokenOb.string)) state.selectBareVars.set(tokenOb.string, state.line);
                 }
                 (state as any)._afterAS = false;
               } else if (tokenCat === "AS") {
